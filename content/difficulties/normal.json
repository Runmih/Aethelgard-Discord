        {
          "title": "🌑 MASS AT THE BARRIER",
          "text": "The darkness beyond Aethelgard is moving. Hundreds of shapes gather outside the Barrier and throw themselves against the light in relentless waves. The shield holds. For now."
        },
        {
          "title": "⛈️ VOIDSTORM",
          "text": "The sky turns black. Lightning crawls across the Barrier without thunder, leaving violet scars hanging in the air. Beyond the city, the Void churns like a stormfront, and something enormous moves inside it."
        },
        {
          "title": "🌧️ BLACK RAIN",
          "text": "Rain begins falling across Aethelgard, but never reaches the ground. Every droplet becomes black mist and rises toward the Barrier as the entire shield starts to hum under mounting pressure."
        },
        {
          "title": "🔇 THE SILENT SURGE",
          "text": "For several minutes the Void becomes completely still. No creatures. No wind. No movement. Then the entire Barrier bends inward at once and a deep vibration rolls through every building in Aethelgard."
        }
      ]
